# Dependencies
node_modules/
bower_components/
# Yarn Classic is the only package manager — ignore npm's lockfile so an accidental
# `npm install` cannot reintroduce it alongside yarn.lock (see CLAUDE.md Tech stack).
package-lock.json

# Build output
/build
/dist

# Test coverage
/coverage

# Playwright e2e output
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Yarn PnP (Zero-installs: keep .yarn/cache; non-Zero-installs: ignore it)
.pnp.*
.pnp/

# Yarn — keep tooling, ignore volatile cache
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Environment variables
.env
.env.local
.env.*.local

# IDE — JetBrains
.idea/

# IDE — VS Code (user-specific settings)
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artefacts
.DS_Store
Thumbs.db

# graphify (see CLAUDE.md's "graphify" section) — graphify-out/ itself is meant to be committed
# once generated, but local API-cost tracking isn't, and neither are these two machine-local
# staging files (an absolute path to this session's Python interpreter and scan root) — every
# graphify subcommand regenerates them on demand if missing (see the skill's own "Interpreter
# guard for subcommands"), and committing them would ship a stale/wrong absolute path to a
# clone on a different machine
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root

# graphify also auto-backs up its "curated" files (community labels, etc.) into a dated
# graphify-out/YYYY-MM-DD/ folder immediately before `graphify update` would overwrite them — a
# local rollback safety net, not a project artifact, and a fresh one appears (with that day's
# date) on any machine that runs an update — so it's excluded the same way cost.json is, rather
# than committed and re-deleted by hand each time
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify-out/cache/ is a pure incremental-rebuild performance cache (per-file AST/semantic hits,
# keyed by graphify's own installed version — graphify-out/cache/ast/vX.Y.Z/) — fully regenerable
# via `graphify update .`, not needed to "start from the same map" (graph.json alone provides
# that), and non-deterministic across machines: every session in this repo so far has had a
# different graphify version installed, so committing this directory produced a rename/rename or
# add/add conflict on nearly every merge touching it. manifest.json is the same story — a raw
# per-file mtime/hash cache for incremental change-detection, not meaningful content.
graphify-out/cache/
graphify-out/manifest.json

# graphify's own pipeline treats .graphify_analysis.json (and its sibling .graphify_detect.json/
# .graphify_extract.json/.graphify_ast.json/.graphify_semantic.json/.graphify_cached.json/
# .graphify_uncached.txt) as intermediate scratch state, explicitly deleted (`rm -f`) at the end
# of a normal run — see the skill's own cleanup step. A leftover copy in this repo predated this
# gitignore entry (a run that didn't clean up after itself); it's ephemeral working state, not a
# project artifact, so it's excluded the same way the rest of graphify's own temp files are.
graphify-out/.graphify_analysis.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_semantic_new.json
graphify-out/.graphify_cached.json
graphify-out/.graphify_uncached.txt
