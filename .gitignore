# Dependencies
node_modules/
bower_components/

# Build output
/build
/dist

# Test coverage
/coverage

# Playwright e2e output
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Yarn PnP (Zero-installs: keep .yarn/cache; non-Zero-installs: ignore it)
.pnp.*
.pnp/

# Yarn — keep tooling, ignore volatile cache
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Environment variables
.env
.env.local
.env.*.local

# IDE — JetBrains
.idea/

# IDE — VS Code (user-specific settings)
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artefacts
.DS_Store
Thumbs.db

# graphify (see CLAUDE.md's "graphify" section) — graphify-out/ itself is meant to be committed
# once generated, but local API-cost tracking isn't, and neither are these two machine-local
# staging files (an absolute path to this session's Python interpreter and scan root) — every
# graphify subcommand regenerates them on demand if missing (see the skill's own "Interpreter
# guard for subcommands"), and committing them would ship a stale/wrong absolute path to a
# clone on a different machine
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
