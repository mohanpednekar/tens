{
  "name": "tens",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "**/glob/minimatch/brace-expansion": "^5.0.12",
    "**/filelist/minimatch/brace-expansion": "^5.0.12",
    "**/fast-uri": "^3.1.6",
    "**/nanoid": "^3.3.17",
    "**/uuid": "11.1.1",
    "**/@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.8.0",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "styled-components": "^6.6.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:dev": "TENS_DEV_BUILD=1 vite build --outDir dist/dev --emptyOutDir false",
    "build:capacitor": "CAPACITOR=1 vite build",
    "cap:sync": "cap sync",
    "cap:android": "yarn build:capacitor && cap sync android && cap open android",
    "android:aab": "yarn build:capacitor && cap sync android && cd android && ./gradlew bundleRelease",
    "android:apk:release": "yarn build:capacitor && cap sync android && cd android && ./gradlew assembleRelease",
    "cap:ios": "yarn build:capacitor && cap sync ios && node scripts/configure-ios-plist.mjs && cap open ios",
    "ios:configure": "node scripts/configure-ios-plist.mjs",
    "test": "vitest run",
    "test:watch": "vitest --host 127.0.0.1",
    "test:e2e": "playwright test",
    "audit": "yarn audit",
    "lint:workflows": "node scripts/lint-workflow-shell.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "gen-pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
